{
  "name": "shortpp",
  "productName": "Short++",
  "version": "1.0.0",
  "description": "A C++ and Python code golf editor",
  "author": "Short++",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "doctor": "node tools/doctor.js"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.shortpp.app",
    "publish": null,
    "productName": "Short++",
    "artifactName": "ShortPP-${version}-${arch}.${ext}",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "core.js",
      "core-py.js",
      "complete.js",
      "main.js",
      "preload.js"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Short++"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "shortpp",
      "maintainer": "Short++",
      "synopsis": "C++ and Python code golf editor",
      "syncDesktopName": true
    },
    "icon": "build/icon.png"
  },
  "desktopName": "shortpp.desktop",
  "homepage": "./"
}
